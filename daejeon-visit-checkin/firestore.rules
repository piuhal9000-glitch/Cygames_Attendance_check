rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /checkins/{checkinId} {
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.matches('^[^@]+@korea\\.ac\\.kr$')
        && request.resource.data.keys().hasOnly([
          'uid',
          'name',
          'place',
          'checkedAt',
          'distanceMeters',
          'accuracyMeters',
          'dateKey'
        ])
        && request.resource.data.uid == request.auth.uid
        && checkinId == request.auth.uid + '_' + request.resource.data.dateKey
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 30
        && request.resource.data.place == '싸이뮤직'
        && request.resource.data.checkedAt == request.time
        && request.resource.data.distanceMeters is number
        && request.resource.data.distanceMeters >= 0
        && request.resource.data.distanceMeters <= 250
        && request.resource.data.accuracyMeters is number
        && request.resource.data.accuracyMeters >= 0
        && request.resource.data.accuracyMeters <= 100
        && request.resource.data.dateKey is string
        && request.resource.data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');

      // 공유받은 조회 페이지에서 로그인 없이 출석 명단을 읽을 수 있습니다.
      // 화면에는 이름과 인증시간만 보이지만, 문서의 다른 필드도 기술적으로 공개됩니다.
      allow read: if true;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
